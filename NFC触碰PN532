//======================
// 中文居中
//======================

void drawCenter(
  int y,
  String text
)
{

  oled.setFont(
    CH_FONT
  );

  int width =
  oled.getUTF8Width(
    text.c_str()
  );

  int x =
  (128-width)/2;

  oled.drawUTF8(
    x,
    y,
    text.c_str()
  );
}

//======================
// 开机界面
//======================

void showStart()
{

  oled.clearBuffer();

  drawCenter(
    28,
    "鱼纹守护者"
  );

  drawCenter(
    50,
    "等待感应"
  );

  oled.sendBuffer();
}

//======================
// 成功动画
//======================

void successAnimation()
{
  for(int r=5;r<=30;r+=5)
  {
    oled.clearBuffer();
    oled.drawCircle(
      64,
      32,
      r
    );

    drawCenter(
      38,
      "认可"
    );

    oled.sendBuffer();

    delay(80);
  }
}

//======================
// 显示结果
//======================

void showResult(
  String name,
  int power,
  String message
)
{
  oled.clearBuffer();
  //标题

  drawCenter(
    14,
    name
  );

  oled.drawHLine(
    10,
    20,
    108
  );

  //愿力值

  oled.setFont(
    u8g2_font_logisoso24_tr
  );

  String p =
  String(power);

  int pw =
  oled.getStrWidth(
    p.c_str()
  );

  oled.drawStr(
    (128-pw)/2,
    48,
    p.c_str()
  );

  //底部提示

  drawCenter(
    63,
    message
  );

  oled.sendBuffer();

}

//======================
// UID转字符串
//======================

String uidToString(
 uint8_t *uid,
 uint8_t length
)
{

 String result="";
 for(int i=0;i<length;i++)
 {
   if(uid[i]<16)
     result+="0";

   result+=
   String(uid[i],HEX);
 }

 result.toUpperCase();
 return result;
}

//======================
// 请求云端
//======================

void checkCloud(
 String uid
)
{

 if(WiFi.status()!=WL_CONNECTED)
 {
   return;
 }

 HTTPClient http;
 http.begin(
   serverURL
 );

 http.addHeader(
   "Content-Type",
   "application/json"
 );

 String body =
 "{\"uid\":\""
 +
 uid
 +
 "\"}";

 Serial.println(
 body
 );

 int code =
 http.POST(body);

 Serial.print(
 "HTTP:"
 );

 Serial.println(code);

 if(code==200)
 {

   String response =
   http.getString();

   Serial.println(response);

   StaticJsonDocument<512> doc;

   DeserializationError error =
   deserializeJson(
     doc,
     response
   );

   if(error)
   {
     Serial.println(
     "JSON ERROR"
     );

     return;
   }

   bool ok =
   doc["ok"];

   if(ok)
   {

     String name =
     doc["data"]["name"];

     int power =
     doc["data"]["power"];

     String message =
     doc["data"]["message"];

     successAnimation();

     showResult(
       name,
       power,
       message
     );

   }

 }

 http.end();
}

//======================
// 初始化
//======================

void setup()
{

 Serial.begin(115200);

 Wire.begin(
   SDA_PIN,
   SCL_PIN
 );

 oled.begin();

 //中文必须

 oled.enableUTF8Print();

 showStart();

 //WiFi

 WiFi.begin(
   ssid,
   password
 );

 Serial.print(
 "WiFi"
 );

 while(
 WiFi.status()!=WL_CONNECTED
 )
 {
   delay(500);

   Serial.print(".");

 }


 Serial.println();

 Serial.println(
 "WiFi OK"
 );

 //PN532

 nfc.begin();

 uint32_t version =
 nfc.getFirmwareVersion();

 if(!version)
 {

   Serial.println(
   "PN532 ERROR"
   );

   while(1);

 }

 nfc.SAMConfig();

 Serial.println(
 "PN532 READY"
 );

}

//======================
// 主循环
//======================

void loop()
{

 uint8_t uid[7];
 uint8_t uidLength;
 bool success =
 nfc.readPassiveTargetID(
 PN532_MIFARE_ISO14443A,
 uid,
 &uidLength
 );


 if(success)
 {
   Serial.println(
   "CARD FOUND"
   );

   String uidString =
   uidToString(
     uid,
     uidLength
   );

   Serial.println(
   uidString
   );

   showStart();

   checkCloud(
     uidString
   );

   delay(3000);

   showStart();

 }
}
