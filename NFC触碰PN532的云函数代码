//index.js
const cloud = require("wx-server-sdk")

cloud.init({
  env: cloud.DYNAMIC_CURRENT_ENV
})

const db = cloud.database()


exports.main = async(event)=>{


  console.log("完整event:")
  console.log(JSON.stringify(event))


  let uid = ""


  // HTTP网关
  if(event.body){

    let body = event.body


    if(typeof body === "string"){
      body = JSON.parse(body)
    }


    uid = body.uid

  }


  // 云函数测试
  else if(event.uid){

    uid = event.uid

  }


  console.log("最终UID:",uid)


  if(!uid){

    return {

      ok:false,

      message:"没有收到UID"

    }

  }



  const result = await db.collection("NFC_Users")
  .where({

    uid:uid

  })
  .get()



  if(result.data.length===0){

    return {

      ok:false,

      message:"未知卡片"

    }

  }



  return {

    ok:true,

    data:result.data[0]

  }



//package.json
{
  "name": "checkNFC",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "wx-server-sdk": "latest"
  }
}



}
